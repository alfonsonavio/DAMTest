<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Va en res/values-night/colors.xml — MODO OSCURO.
     Redefine SOLO los tokens semánticos con valores oscuros; como toda
     la app usa estos nombres, las pantallas se adaptan solas. Los alias
     de compatibilidad son referencias (@color/…) y heredan de aquí, así
     que no hay que duplicarlos. white/black no cambian.
     Base: grafito neutro (no negro puro).
     ============================================================ -->
<resources>

    <!-- === Marca / principal (Navy — cabeceras) — se mantiene navy === -->
    <color name="brand_navy">#1E293B</color>
    <color name="brand_navy_light">#334155</color>
    <color name="brand_navy_dark">#0F172A</color>

    <!-- === Interactivo (Periwinkle) — aclarado para contrastar sobre oscuro === -->
    <color name="brand_primary">#6366F1</color>
    <color name="brand_primary_light">#818CF8</color>
    <color name="brand_primary_dark">#4F46E5</color>
    <color name="brand_primary_bg">#312E81</color>

    <!-- === Acento (Frambuesa) — aclarado para modo oscuro === -->
    <color name="accent_raspberry">#FB7185</color>
    <color name="accent_raspberry_light">#FDA4AF</color>
    <color name="accent_raspberry_bg">#4C1D28</color>

    <!-- === Superficies y fondos — GRAFITO NEUTRO === -->
    <color name="surface">#1E2024</color>
    <color name="surface_bg">#121417</color>
    <color name="surface_border">#2A2F36</color>
    <!-- Velo de carga (overlay casi opaco del color de fondo) -->
    <color name="scrim">#F2121417</color>

    <!-- === Texto === -->
    <color name="text_primary">#F1F5F9</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="text_muted">#64748B</color>
    <color name="text_on_dark">#FFFFFF</color>
    <color name="text_on_dark_muted">#94A3B8</color>

    <!-- === Estados semánticos — color vivo, contenedor oscuro, texto claro === -->
    <color name="state_success">#22C55E</color>
    <color name="state_success_bg">#14532D</color>
    <color name="state_success_text">#86EFAC</color>
    <color name="state_error">#EF4444</color>
    <color name="state_error_bg">#4C1D1D</color>
    <color name="state_error_text">#FCA5A5</color>

    <!-- === Colores de asignaturas — invertidos: fondo oscuro tintado + texto pastel claro === -->
    <color name="subject_prog_bg">#312E81</color>
    <color name="subject_prog_fg">#C7D2FE</color>
    <color name="subject_db_bg">#0C4A6E</color>
    <color name="subject_db_fg">#BAE6FD</color>
    <color name="subject_sistemas_bg">#78350F</color>
    <color name="subject_sistemas_fg">#FDE68A</color>
    <color name="subject_marcas_bg">#831843</color>
    <color name="subject_marcas_fg">#FBCFE8</color>
    <color name="subject_entornos_bg">#581C87</color>
    <color name="subject_entornos_fg">#E9D5FF</color>
    <color name="subject_digital_bg">#134E4A</color>
    <color name="subject_digital_fg">#99F6E4</color>
    <color name="subject_ipe_bg">#881337</color>
    <color name="subject_ipe_fg">#FECDD3</color>
    <color name="subject_sostenibilidad_bg">#14532D</color>
    <color name="subject_sostenibilidad_fg">#BBF7D0</color>

</resources>
