<?xml version="1.0" encoding="utf-8"?>
<!-- Va en res/values/type.xml — jerarquía tipográfica DAMTest.
     Títulos en Poppins, texto en Inter. Usa estos estilos en los TextView
     con android:textAppearance="@style/TextAppearance.DAMTest.XXX" -->
<resources>

    <!-- === TÍTULOS (Poppins) === -->

    <!-- Saludo grande, cabecera de pantalla -->
    <style name="TextAppearance.DAMTest.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Título de sección -->
    <style name="TextAppearance.DAMTest.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Título de tarjeta (asignatura, pregunta) -->
    <style name="TextAppearance.DAMTest.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Números grandes (stats) -->
    <style name="TextAppearance.DAMTest.Stat" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- === TEXTO (Inter) === -->

    <!-- Cuerpo principal: preguntas, opciones -->
    <style name="TextAppearance.DAMTest.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Texto secundario: descripciones, subtítulos -->
    <style name="TextAppearance.DAMTest.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Etiquetas pequeñas, captions -->
    <style name="TextAppearance.DAMTest.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Texto de botón -->
    <style name="TextAppearance.DAMTest.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>