<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <!-- The toolbar reaches up behind the status bar; the code adds its height on top -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_topics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brand_navy"
        app:navigationIconTint="@color/text_on_dark"
        app:titleTextColor="@color/text_on_dark" />

    <!-- Practicar: always in view, above the topics -->
    <LinearLayout
        android:id="@+id/practiceSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/practice_header"
            android:textAppearance="@style/TextAppearance.DAMTest.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardExam"
                layout="@layout/view_practice_card" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/cardSmartReview"
                layout="@layout/view_practice_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardGeneralTest"
                layout="@layout/view_practice_card" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/cardFavorites"
                layout="@layout/view_practice_card" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTopicsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:textAppearance="@style/TextAppearance.DAMTest.Caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTopics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>