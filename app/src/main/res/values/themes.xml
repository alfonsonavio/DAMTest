<?xml version="1.0" encoding="utf-8"?>
<!-- Va en res/values/themes.xml — tema base DAMTest (modo claro).
     Migrado a Material 3. El dark mode se añadirá en values-night en la
     rama dark-mode. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DAMTest" parent="Theme.Material3.Light.NoActionBar">

        <!-- Interactivo (periwinkle) como primario M3 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>
        <item name="colorPrimaryContainer">@color/brand_primary_bg</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <!-- Acento (frambuesa) como secundario M3 -->
        <item name="colorSecondary">@color/accent_raspberry</item>
        <item name="colorOnSecondary">@color/text_on_dark</item>
        <item name="colorSecondaryContainer">@color/accent_raspberry_bg</item>
        <item name="colorOnSecondaryContainer">@color/accent_raspberry</item>

        <!-- Navy de marca como terciario M3 -->
        <item name="colorTertiary">@color/brand_navy</item>
        <item name="colorOnTertiary">@color/text_on_dark</item>

        <!-- Superficies -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_border</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_muted</item>
        <item name="colorOutlineVariant">@color/surface_border</item>

        <!-- Errores -->
        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/text_on_dark</item>
        <item name="colorErrorContainer">@color/state_error_bg</item>
        <item name="colorOnErrorContainer">@color/state_error_text</item>

        <!-- Tipografía por defecto (Inter para todo el texto base) -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- Barra de estado: navy, con iconos claros -->
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Sin ActionBar (usamos toolbars propias) -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Estilo de botón principal (periwinkle, texto Inter, esquinas 12dp) -->
    <style name="Widget.DAMTest.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.DAMTest.Button</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Botones de respuesta del quiz -->
    <style name="Widget.DAMTest.QuizOption" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.DAMTest.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="HomeStatPill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_stat_pill</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.DAMTest.SegmentedButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.DAMTest.Button</item>
        <item name="android:textColor">@color/segmented_text_color</item>
        <item name="backgroundTint">@color/segmented_bg_color</item>
        <item name="cornerRadius">11dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="rippleColor">@color/brand_navy_light</item>
    </style>

    <style name="StatKpiCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_kpi_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/surface_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">14dp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/surface_border</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>
</resources>