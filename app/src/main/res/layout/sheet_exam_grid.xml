<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preguntas"
        android:textAppearance="@style/TextAppearance.DAMTest.CardTitle" />

    <TextView
        android:id="@+id/tvSheetSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.DAMTest.Secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Relleno: respondida · Borde naranja: dudosa · Borde oscuro: actual"
        android:textAppearance="@style/TextAppearance.DAMTest.Caption" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExamGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetSubmit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="ENTREGAR EXAMEN"
        app:backgroundTint="@color/brand_navy"
        app:cornerRadius="16dp" />
</LinearLayout>